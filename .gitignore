# Day planning, not part of the project
PLAN.md

# Rust
/target/
**/target/
*.rs.bk

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Simulation outputs. The csv rules name what sim-report writes under a --telemetry dir (manifest and
# the per-run summary, requests and series dumps), not every csv, so scenario fixtures such as
# scenarios/traces/*.csv are tracked without a force-add.
out/
results/
manifest.csv
*.summary.csv
*.requests.csv
*.series.csv
*.parquet

# draw.io backups
*.drawio.bkp
*.drawio.dtmp

# OS
.DS_Store

# Benchmark build artifacts
bench/queue/target/

# Rust build and simulator output
/target/
/out/

# Exported demo runs placed beside the web app for local replay (web/README.md "Replay mode"): a 16 MB
# build product of the engine, regenerated by `sim-run export --demos`, never committed.
web/public/runs/

# Credentials. Nothing of this shape should ever be in this repo; the deploy key lives in
# ~/.config/gcloud, outside it. These rules exist so an accident is caught by git rather than by a
# later audit.
*.pem
*.p12
*.key
id_rsa*
.env
.env.*
.netrc
.npmrc
credentials.json
client_secret*.json
service-account*.json
*-key.json
gcloud/
