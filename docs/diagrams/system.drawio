        <object label="RunResult" proto="proto/lbsim/v1/metrics.proto" rpc="RunResult" kind="internal" id="e2_met_srv">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#6A1B9A;" edge="1" parent="1" source="met" target="srv"><mxGeometry relative="1" as="geometry" /></mxCell>
