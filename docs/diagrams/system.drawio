        </object>
        <object label="Failure detection policy&#10;straggler ejection" component="sim-policy::detection" id="p_detect">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=10;" vertex="1" parent="1"><mxGeometry x="90" y="230" width="170" height="60" as="geometry" /></mxCell>
        </object>
        <object label="Autoscaling policy&#10;reactive or predictive" component="sim-policy::autoscaling" id="p_scale">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="230" width="200" height="60" as="geometry" /></mxCell>
        </object>
        <object label="Capacity management&#10;warm pool, quota (in Ingress)" component="sim-ingress::capacity" id="cm">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="230" width="175" height="60" as="geometry" /></mxCell>
        </object>

        <object label="Event queue" component="sim-core::queue" id="eq2">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="405" width="160" height="65" as="geometry" /></mxCell>
        </object>
        <object label="Cost model&#10;analytic epochs" component="sim-physics::cost" id="cost2">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="405" width="170" height="65" as="geometry" /></mxCell>
        </object>
        <object label="Referee" component="sim-physics::referee" id="ref2">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="405" width="150" height="65" as="geometry" /></mxCell>
        </object>
        <object label="Seeded RNG streams&#10;named, independent" component="sim-core::rng" id="rng">
