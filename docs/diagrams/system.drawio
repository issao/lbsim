<mxfile host="app.diagrams.net" compressed="false" type="device">
  <diagram id="dataplane" name="1. Data plane and policy boundary">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="g_policy" value="POLICY LAYER — pure functions of a stale Observation; return Intents; hold no simulation state" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9E9E9E;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#616161;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1120" height="115" as="geometry" /></mxCell>
        <mxCell id="g_data" value="MODELLED DATA PLANE — every arrow is one rpc in proto/lbsim/v1/, and pays a configured latency, jitter and loss" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9E9E9E;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#616161;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="1120" height="155" as="geometry" /></mxCell>
        <mxCell id="g_phys" value="SIMULATION ENGINE — physics; no policy may bypass the referee" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9E9E9E;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#616161;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1120" height="130" as="geometry" /></mxCell>

        <object label="Admission and shaping policy" component="sim-policy::admission" id="p_admit">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=11;" vertex="1" parent="1"><mxGeometry x="265" y="65" width="175" height="60" as="geometry" /></mxCell>
        </object>
        <object label="Routing policy&#10;round_robin | p2c | least_kv | prefix_affinity" component="sim-policy::routing" id="p_route">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="65" width="175" height="60" as="geometry" /></mxCell>
        </object>
        <object label="Batch scheduling policy&#10;step budget, admit order" component="sim-policy::scheduling" id="p_sched">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=10;" vertex="1" parent="1"><mxGeometry x="695" y="65" width="175" height="60" as="geometry" /></mxCell>
        </object>
        <object label="Preemption policy&#10;swap or recompute" component="sim-policy::preemption" id="p_preempt">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=10;" vertex="1" parent="1"><mxGeometry x="910" y="65" width="175" height="60" as="geometry" /></mxCell>
        </object>

        <object label="Workload and clients&#10;arrivals, sessions, retries" component="sim-workload" id="wl">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="160" height="70" as="geometry" /></mxCell>
        </object>
        <object label="Gateway" component="sim-model::gateway" id="gw">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="265" y="240" width="175" height="70" as="geometry" /></mxCell>
        </object>
        <object label="Router" component="sim-model::router" id="rt">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="240" width="175" height="70" as="geometry" /></mxCell>
        </object>
        <object label="Replica engine&#10;continuous batching, KV accounting" component="sim-model::replica" id="re">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="695" y="240" width="175" height="70" as="geometry" /></mxCell>
        </object>
        <object label="KV tier pool&#10;cluster DRAM and SSD" component="sim-physics::tiers" id="kvt">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="910" y="240" width="175" height="70" as="geometry" /></mxCell>
        </object>

        <object label="Event queue&#10;two-level, replica-keyed" component="sim-core::queue" id="eq">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="465" width="170" height="70" as="geometry" /></mxCell>
        </object>
