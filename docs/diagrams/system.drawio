        </object>
        <object label="Intent.Route" proto="proto/lbsim/v1/policy.proto" rpc="Intent" kind="intent" id="e_rt_ref">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#2E7D32;" edge="1" parent="1" source="rt" target="ref"><mxGeometry relative="1" as="geometry" /></mxCell>
        </object>
        <object label="Intent.Admit / SetStepBudget / Preempt" proto="proto/lbsim/v1/policy.proto" rpc="Intent" kind="intent" id="e_re_ref">
