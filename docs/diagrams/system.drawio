        </object>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="controlplane" name="2. Control plane, engine, product">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="g2_ctrl" value="MODELLED CONTROL PLANE — the staleness and actuation boundary; sensor period plus propagation delay plus cold start is what makes this loop oscillate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9E9E9E;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#616161;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1120" height="290" as="geometry" /></mxCell>
        <mxCell id="g2_eng" value="SIMULATION ENGINE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9E9E9E;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#616161;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1120" height="130" as="geometry" /></mxCell>
        <mxCell id="g2_prod" value="PRODUCT SURFACE — served for real over gRPC and grpc-web" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9E9E9E;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#616161;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="1120" height="140" as="geometry" /></mxCell>

