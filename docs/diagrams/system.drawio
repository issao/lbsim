        </object>

        <object label="Generate (stream)" proto="proto/lbsim/v1/serving.proto" rpc="Gateway.Generate" kind="stream" id="e_wl_gw">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeWidth=2;strokeColor=#1565C0;" edge="1" parent="1" source="wl" target="gw"><mxGeometry relative="1" as="geometry" /></mxCell>
        </object>
        <object label="Route" proto="proto/lbsim/v1/serving.proto" rpc="Router.Route" kind="rpc" id="e_gw_rt">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#1565C0;" edge="1" parent="1" source="gw" target="rt"><mxGeometry relative="1" as="geometry" /></mxCell>
        </object>
        <object label="Execute (stream)" proto="proto/lbsim/v1/serving.proto" rpc="ReplicaEngine.Execute" kind="stream" id="e_rt_re">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeWidth=2;strokeColor=#1565C0;" edge="1" parent="1" source="rt" target="re"><mxGeometry relative="1" as="geometry" /></mxCell>
        </object>
        <object label="Cancel — without it, a client timeout leaves the replica generating tokens nobody reads" proto="proto/lbsim/v1/serving.proto" rpc="ReplicaEngine.Cancel" kind="rpc" id="e_gw_re">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;dashed=1;strokeColor=#1565C0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="re"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="352" y="340" /><mxPoint x="739" y="340" /></Array></mxGeometry></mxCell>
        </object>
        <object label="TierRequest / TierGrant — shared tier bandwidth, arbitrated by Ingress" proto="proto/lbsim/v1/leaf.proto" rpc="TierRequest" kind="rpc" id="e_re_kvt">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;startArrow=block;startFill=1;strokeColor=#1565C0;" edge="1" parent="1" source="re" target="kvt"><mxGeometry relative="1" as="geometry" /></mxCell>
        </object>

        <object label="Observation / Decision" proto="proto/lbsim/v1/policy.proto" rpc="Policy.Decide" kind="call" id="e_gw_padmit">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;dashed=1;strokeColor=#F9A825;startArrow=block;startFill=1;" edge="1" parent="1" source="gw" target="p_admit"><mxGeometry relative="1" as="geometry" /></mxCell>
        </object>
        <object label="Observation / Decision" proto="proto/lbsim/v1/policy.proto" rpc="Policy.Decide" kind="call" id="e_rt_proute">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;dashed=1;strokeColor=#F9A825;startArrow=block;startFill=1;" edge="1" parent="1" source="rt" target="p_route"><mxGeometry relative="1" as="geometry" /></mxCell>
        </object>
        <object label="Observation / Decision" proto="proto/lbsim/v1/policy.proto" rpc="Policy.Decide" kind="call" id="e_re_psched">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;dashed=1;strokeColor=#F9A825;startArrow=block;startFill=1;" edge="1" parent="1" source="re" target="p_sched"><mxGeometry relative="1" as="geometry" /></mxCell>
        </object>
        <object label="Observation / Decision" proto="proto/lbsim/v1/policy.proto" rpc="Policy.Decide" kind="call" id="e_re_ppreempt">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;dashed=1;strokeColor=#F9A825;startArrow=block;startFill=1;exitX=0.9;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="re" target="p_preempt"><mxGeometry relative="1" as="geometry" /></mxCell>
        </object>

        <object label="Intent.Reject" proto="proto/lbsim/v1/policy.proto" rpc="Intent" kind="intent" id="e_gw_ref">
