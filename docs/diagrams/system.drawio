        </object>

        <object label="sim-run CLI&#10;batch scenario sweeps" component="sim-run" id="run">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="590" width="170" height="65" as="geometry" /></mxCell>
        </object>
        <object label="sim-ingress&#10;Ingress service" component="sim-ingress" id="srv">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="590" width="180" height="65" as="geometry" /></mxCell>
        </object>
        <object label="React dashboard&#10;playground and showcase" component="web" id="web">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="590" width="180" height="65" as="geometry" /></mxCell>
        </object>
        <object label="Static HTML report&#10;links back for replay" component="sim-run::report" id="rpt">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="590" width="180" height="65" as="geometry" /></mxCell>
        </object>

        <object label="PublishState — sensor, period T_s plus jitter" proto="proto/lbsim/v1/telemetry.proto" rpc="TelemetryCollector.PublishState" kind="rpc" id="e2_re_tc">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#1565C0;" edge="1" parent="1" source="re2" target="tc"><mxGeometry relative="1" as="geometry" /></mxCell>
        </object>
        <object label="WatchFleet — entries carry their own sampled_at_ns, so a snapshot is not a consistent cut" proto="proto/lbsim/v1/telemetry.proto" rpc="TelemetryCollector.WatchFleet" kind="stream" id="e2_tc_rt">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeWidth=2;strokeColor=#C62828;" edge="1" parent="1" source="tc" target="rt2"><mxGeometry relative="1" as="geometry" /></mxCell>
        </object>
        <object label="WatchFleet" proto="proto/lbsim/v1/telemetry.proto" rpc="TelemetryCollector.WatchFleet" kind="stream" id="e2_tc_pscale">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#C62828;" edge="1" parent="1" source="tc" target="p_scale"><mxGeometry relative="1" as="geometry" /></mxCell>
        </object>
        <object label="WatchFleet plus silent list — absence of data is not evidence of failure" proto="proto/lbsim/v1/telemetry.proto" rpc="TelemetryCollector.WatchFleet" kind="stream" id="e2_tc_pdetect">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#C62828;" edge="1" parent="1" source="tc" target="p_detect"><mxGeometry relative="1" as="geometry" /></mxCell>
        </object>
        <object label="Intent.EjectReplica" proto="proto/lbsim/v1/policy.proto" rpc="Intent.EjectReplica" kind="intent" id="e2_pdetect_rt">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#F9A825;dashed=1;" edge="1" parent="1" source="p_detect" target="rt2"><mxGeometry relative="1" as="geometry" /></mxCell>
        </object>
        <object label="Intent.ScalePool" proto="proto/lbsim/v1/policy.proto" rpc="Intent.ScalePool" kind="intent" id="e2_pscale_cm">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#F9A825;dashed=1;" edge="1" parent="1" source="p_scale" target="cm"><mxGeometry relative="1" as="geometry" /></mxCell>
        </object>
        <object label="actuator: cold start 30 to 300 s, far slower than a burst develops" proto="proto/lbsim/v1/leaf.proto" rpc="ControlAction" kind="rpc" id="e2_cm_re">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeWidth=2;strokeColor=#C62828;" edge="1" parent="1" source="cm" target="re2"><mxGeometry relative="1" as="geometry" /></mxCell>
