        </object>
        <object label="step time T(n) = n*beta + alpha*n*(n-1)/2" kind="internal" id="e_cost_re">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#757575;dashed=1;" edge="1" parent="1" source="cost" target="re"><mxGeometry relative="1" as="geometry" /></mxCell>
