        </object>
        <object label="Telemetry collector&#10;whole snapshots on an interval" component="sim-model::telemetry" id="tc">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="75" width="200" height="65" as="geometry" /></mxCell>
        </object>
        <object label="Replica engine" component="sim-model::replica" id="re2">
